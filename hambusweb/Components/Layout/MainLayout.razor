@inherits LayoutComponentBase

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4 shell-links">
            <span class="shell-summary">Blazor Server app with plain static pages for HamBus suite content.</span>
            <div class="shell-actions">
                <a href="/static/index.html">Static pages</a>
                <a href="/static/hambuslog.html">HamBusLog</a>
            </div>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
