<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:HamBusLog.ViewModels"
        x:Class="HamBusLog.Views.DigitalVoiceKeyerWindow"
        x:DataType="vm:DigitalVoiceKeyerViewModel"
        Title="Digital Voice Keyer"
        Width="960"
        Height="560"
        MinWidth="820"
        MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppWindowBackgroundBrush}"
        Foreground="{DynamicResource AppForegroundBrush}">

    <Grid Margin="10" RowDefinitions="Auto,*,Auto" RowSpacing="8">
        <Border Grid.Row="0" Padding="10" CornerRadius="8"
                BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1"
                Background="{DynamicResource AppPanelBackgroundBrush}">
            <Grid RowDefinitions="Auto,Auto" RowSpacing="8">
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock Text="Digital Voice Keyer" FontSize="18" FontWeight="Bold" />
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" VerticalAlignment="Center">
                            <TextBlock Grid.Column="0"
                                       Text="Log type:"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource AppMutedForegroundBrush}" />
                            <ComboBox Grid.Column="1"
                                      MinWidth="260"
                                      HorizontalAlignment="Left"
                                      ItemsSource="{Binding AvailableLogTypes}"
                                      SelectedItem="{Binding SelectedLogType, Mode=TwoWay}"
                                      DisplayMemberBinding="{Binding DisplayName}" />
                        </Grid>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <CheckBox Name="StayOnTopCheckBox"
                                  Content="Always on top"
                                  VerticalAlignment="Center"
                                  Foreground="{DynamicResource AppForegroundBrush}"
                                  TextElement.Foreground="{DynamicResource AppForegroundBrush}"
                                  Checked="OnStayOnTopChecked"
                                  Unchecked="OnStayOnTopUnchecked" />
                        <CheckBox Content="Compact view"
                                  VerticalAlignment="Center"
                                  IsChecked="{Binding IsCompactView, Mode=TwoWay}"
                                  Foreground="{DynamicResource AppForegroundBrush}"
                                  TextElement.Foreground="{DynamicResource AppForegroundBrush}" />
                        <Button Content="Reload"
                                Padding="10,5"
                                Click="OnReloadClicked"
                                Background="{DynamicResource AppButtonNormalBrush}"
                                Foreground="{DynamicResource AppButtonNormalForegroundBrush}" />
                        <Button Content="Save"
                                Padding="10,5"
                                Click="OnSaveClicked"
                                Background="{DynamicResource AppButtonCautionBrush}"
                                Foreground="{DynamicResource AppButtonCautionForegroundBrush}" />
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1" ColumnDefinitions="Auto,*" ColumnSpacing="8" VerticalAlignment="Center">
                    <TextBlock Grid.Column="0"
                               Text="Playback output:"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource AppMutedForegroundBrush}" />
                    <ComboBox Grid.Column="1"
                              MinWidth="300"
                              HorizontalAlignment="Left"
                              ItemsSource="{Binding AvailableOutputDevices}"
                              SelectedItem="{Binding SelectedOutputDevice, Mode=TwoWay}"
                              DisplayMemberBinding="{Binding DisplayName}"
                              ToolTip.Tip="{Binding SelectedOutputDevice.Value}" />
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1"
                CornerRadius="8"
                Background="{DynamicResource AppPanelBackgroundBrush}">
            <Grid RowDefinitions="Auto,*" RowSpacing="4" Margin="8">
                <Grid Grid.Row="0"
                      IsVisible="{Binding IsDetailedView}"
                      ColumnDefinitions="64,84,84,320,*,300" ColumnSpacing="8" Margin="2,0,2,4">
                    <TextBlock Text="Slot" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AppMutedForegroundBrush}" />
                    <TextBlock Grid.Column="1" Text="Record" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AppMutedForegroundBrush}" />
                    <TextBlock Grid.Column="2" Text="Delete" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AppMutedForegroundBrush}" />
                    <TextBlock Grid.Column="3" Text="Button Label" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AppMutedForegroundBrush}" />
                    <TextBlock Grid.Column="4" Text="Recording" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AppMutedForegroundBrush}" />
                    <TextBlock Grid.Column="5" Text="Test / Play / Repeat (s)" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AppMutedForegroundBrush}" />
                </Grid>

                <Grid Grid.Row="0"
                      IsVisible="{Binding IsCompactView}"
                      ColumnDefinitions="3*,220" ColumnSpacing="8" Margin="2,0,2,4">
                    <TextBlock Text="Button Label" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AppMutedForegroundBrush}" />
                    <TextBlock Grid.Column="1" Text="Play / Repeat (s)" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AppMutedForegroundBrush}" />
                </Grid>

                <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Rows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:DigitalVoiceKeyerRowViewModel">
                                <Border BorderBrush="{DynamicResource AppBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Background="{DynamicResource AppWindowBackgroundBrush}"
                                        Padding="6"
                                        Margin="0,0,0,6">
                                    <Grid>
                                    <Grid IsVisible="{Binding IsDetailedView}" ColumnDefinitions="64,84,84,320,*,300" ColumnSpacing="8" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding SlotNumber, StringFormat=S{0:00}}"
                                                   VerticalAlignment="Center"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource AppMutedForegroundBrush}" />

                                        <Button Grid.Column="1"
                                                Content="{Binding RecordButtonText}"
                                                Click="OnSlotRecordButtonClicked"
                                                Tag="{Binding SlotNumber}"
                                                MinWidth="72"
                                                ToolTip.Tip="Record or stop slot audio"
                                                Background="{DynamicResource AppButtonNormalBrush}"
                                                Foreground="{DynamicResource AppButtonNormalForegroundBrush}" />

                                        <Button Grid.Column="2"
                                                Content="Delete"
                                                Click="OnSlotDeleteButtonClicked"
                                                Tag="{Binding SlotNumber}"
                                                MinWidth="62"
                                                ToolTip.Tip="Delete slot audio"
                                                Background="{DynamicResource AppButtonDangerBrush}"
                                                Foreground="{DynamicResource AppButtonDangerForegroundBrush}" />

                                        <TextBox Grid.Column="3"
                                                 Text="{Binding Label, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 Watermark="CQ WA1GON"
                                                 VerticalAlignment="Center" />

                                        <TextBlock Grid.Column="4"
                                                   Text="{Binding RecordingFileName}"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource AppMutedForegroundBrush}"
                                                   FontSize="11" />

                                        <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <Button Content="Test"
                                                    Click="OnSlotTestButtonClicked"
                                                    Tag="{Binding SlotNumber}"
                                                    MinWidth="56"
                                                    ToolTip.Tip="Play to system default without keying transmit"
                                                    Background="{DynamicResource AppButtonCautionBrush}"
                                                    Foreground="{DynamicResource AppButtonCautionForegroundBrush}" />
                                            <Button Content="{Binding PlayButtonText}"
                                                    Click="OnSlotPlayButtonClicked"
                                                    PointerPressed="OnSlotPlayButtonPointerPressed"
                                                    Tag="{Binding SlotNumber}"
                                                    MinWidth="72"
                                                    ToolTip.Tip="Play once when delay is 0; repeat when delay > 0"
                                                    Background="{DynamicResource AppButtonNormalBrush}"
                                                    Foreground="{DynamicResource AppButtonNormalForegroundBrush}" />
                                            <NumericUpDown Width="104"
                                                           Minimum="0"
                                                           Increment="1"
                                                           FormatString="F0"
                                                           Value="{Binding RepeatDelaySeconds, Mode=TwoWay}"
                                                           ToolTip.Tip="Repeat delay in seconds (0 = no repeat)" />
                                        </StackPanel>
                                    </Grid>

                                    <Grid IsVisible="{Binding IsCompactView}" ColumnDefinitions="3*,220" ColumnSpacing="8" VerticalAlignment="Center">
                                        <TextBox Grid.Column="0"
                                                 Text="{Binding Label, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 Watermark="CQ WA1GON"
                                                 VerticalAlignment="Center" />

                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <Button Content="{Binding PlayButtonText}"
                                                    Click="OnSlotPlayButtonClicked"
                                                    PointerPressed="OnSlotPlayButtonPointerPressed"
                                                    Tag="{Binding SlotNumber}"
                                                    MinWidth="72"
                                                    ToolTip.Tip="Play once when delay is 0; repeat when delay > 0"
                                                    Background="{DynamicResource AppButtonNormalBrush}"
                                                    Foreground="{DynamicResource AppButtonNormalForegroundBrush}" />
                                            <NumericUpDown Width="104"
                                                           Minimum="0"
                                                           Increment="1"
                                                           FormatString="F0"
                                                           Value="{Binding RepeatDelaySeconds, Mode=TwoWay}"
                                                           ToolTip.Tip="Repeat delay in seconds (0 = no repeat)" />
                                        </StackPanel>
                                    </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <Border Grid.Row="2" Padding="8,6"
                BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1"
                CornerRadius="8"
                Background="{DynamicResource AppPanelBackgroundBrush}">
            <Grid ColumnDefinitions="Auto,*">
                <TextBlock Grid.Column="0"
                           Text="STATUS"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Margin="0,0,8,0"
                           Foreground="{DynamicResource AppMutedForegroundBrush}" />
                <TextBlock Grid.Column="1"
                           Text="{Binding StatusMessage}"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource AppMutedForegroundBrush}" />
            </Grid>
        </Border>
    </Grid>
</Window>















