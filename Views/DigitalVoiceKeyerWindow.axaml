<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:HamBusLog.ViewModels"
        x:Class="HamBusLog.Views.DigitalVoiceKeyerWindow"
        x:DataType="vm:DigitalVoiceKeyerViewModel"
        Title="Digital Voice Keyer"
        Width="960"
        Height="560"
        MinWidth="820"
        MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppWindowBackgroundBrush}"
        Foreground="{DynamicResource AppForegroundBrush}">

    <Grid Margin="10" RowDefinitions="Auto,*,Auto" RowSpacing="8">
        <Border Grid.Row="0" Padding="10" CornerRadius="8"
                BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1"
                Background="{DynamicResource AppPanelBackgroundBrush}">
            <Grid RowDefinitions="Auto,Auto" RowSpacing="8">
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock Text="Digital Voice Keyer" FontSize="18" FontWeight="Bold" />
                        <TextBlock Text="{Binding SelectedLogTypeDisplayName, StringFormat=Global log type: {0}}"
                                   Foreground="{DynamicResource AppMutedForegroundBrush}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button Content="Reload"
                                Padding="10,5"
                                Click="OnReloadClicked"
                                Background="{DynamicResource AppButtonNormalBrush}"
                                Foreground="{DynamicResource AppButtonNormalForegroundBrush}" />
                        <Button Content="Save"
                                Padding="10,5"
                                Click="OnSaveClicked"
                                Background="{DynamicResource AppButtonCautionBrush}"
                                Foreground="{DynamicResource AppButtonCautionForegroundBrush}" />
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1" ColumnDefinitions="Auto,*" ColumnSpacing="8" VerticalAlignment="Center">
                    <TextBlock Grid.Column="0"
                               Text="Playback output:"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource AppMutedForegroundBrush}" />
                    <ComboBox Grid.Column="1"
                              MinWidth="300"
                              HorizontalAlignment="Left"
                              ItemsSource="{Binding AvailableOutputDevices}"
                              SelectedItem="{Binding SelectedOutputDevice, Mode=TwoWay}" />
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1"
                CornerRadius="8"
                Background="{DynamicResource AppPanelBackgroundBrush}">
            <Grid RowDefinitions="Auto,*" RowSpacing="4" Margin="8">
                <Grid Grid.Row="0" ColumnDefinitions="64,3*,*,Auto" ColumnSpacing="8" Margin="2,0,2,4">
                    <TextBlock Text="Slot" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AppMutedForegroundBrush}" />
                    <TextBlock Grid.Column="1" Text="Button Label" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AppMutedForegroundBrush}" />
                    <TextBlock Grid.Column="2" Text="Recording" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AppMutedForegroundBrush}" />
                    <TextBlock Grid.Column="3" Text="Actions" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AppMutedForegroundBrush}" />
                </Grid>

                <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Rows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:DigitalVoiceKeyerRowViewModel">
                                <Border BorderBrush="{DynamicResource AppBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Background="{DynamicResource AppWindowBackgroundBrush}"
                                        Padding="6"
                                        Margin="0,0,0,6">
                                    <Grid ColumnDefinitions="64,3*,*,Auto" ColumnSpacing="8" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding SlotNumber, StringFormat=S{0:00}}"
                                                   VerticalAlignment="Center"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource AppMutedForegroundBrush}" />

                                        <TextBox Grid.Column="1"
                                                 Text="{Binding Label, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 Watermark="CQ WA1GON"
                                                 VerticalAlignment="Center" />

                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding RecordingFileName}"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource AppMutedForegroundBrush}"
                                                   FontSize="11" />

                                        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6">
                                            <Button Content="{Binding RecordButtonText}"
                                                    Click="OnSlotRecordButtonClicked"
                                                    Tag="{Binding SlotNumber}"
                                                    MinWidth="72"
                                                    ToolTip.Tip="Record or stop slot audio"
                                                    Background="{DynamicResource AppButtonNormalBrush}"
                                                    Foreground="{DynamicResource AppButtonNormalForegroundBrush}" />
                                            <Button Content="Play"
                                                    Click="OnSlotPlayButtonClicked"
                                                    Tag="{Binding SlotNumber}"
                                                    MinWidth="58"
                                                    ToolTip.Tip="Play slot audio"
                                                    Background="{DynamicResource AppButtonNormalBrush}"
                                                    Foreground="{DynamicResource AppButtonNormalForegroundBrush}" />
                                            <Button Content="Delete"
                                                    Click="OnSlotDeleteButtonClicked"
                                                    Tag="{Binding SlotNumber}"
                                                    MinWidth="62"
                                                    ToolTip.Tip="Delete slot audio"
                                                    Background="{DynamicResource AppButtonDangerBrush}"
                                                    Foreground="{DynamicResource AppButtonDangerForegroundBrush}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <Border Grid.Row="2" Padding="8,6"
                BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1"
                CornerRadius="8"
                Background="{DynamicResource AppPanelBackgroundBrush}">
            <Grid ColumnDefinitions="Auto,*">
                <TextBlock Grid.Column="0"
                           Text="STATUS"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Margin="0,0,8,0"
                           Foreground="{DynamicResource AppMutedForegroundBrush}" />
                <TextBlock Grid.Column="1"
                           Text="{Binding StatusMessage}"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource AppMutedForegroundBrush}" />
            </Grid>
        </Border>
    </Grid>
</Window>








