<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="HamBusLog.Views.SplashWindow"
        Title="HamBusLog"
        Width="700"
        Height="440"
        CanResize="False"
        ShowInTaskbar="False"
        SystemDecorations="None"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        TransparencyLevelHint="AcrylicBlur">

    <Border CornerRadius="14"
            ClipToBounds="True"
            Background="#EE0F172A"
            BorderBrush="#44FFFFFF"
            BorderThickness="1">

        <Grid RowDefinitions="*,Auto">

            <!-- Logo image fills the upper area -->
            <Image Grid.Row="0"
                   Name="SplashLogo"
                   Source="/images/hambus-large.png"
                   Stretch="Uniform"
                   Margin="40,36,40,16"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Center" />

            <!-- Bottom strip: countdown + version -->
            <Border Grid.Row="1"
                    Background="#22FFFFFF"
                    Padding="28,14">
                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="HamBusLog"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="#E5E7EB"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="·"
                                   FontSize="18"
                                   Foreground="#4B5563"
                                   VerticalAlignment="Center" />
                        <TextBlock Name="CountdownText"
                                   Text="Click anywhere to continue"
                                   FontSize="13"
                                   Foreground="#94A3B8"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Vertical" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Name="VersionText"
                                   Text="v0.2.0"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#E5E7EB"
                                   HorizontalAlignment="Right" />
                        <TextBlock Name="BuildText"
                                   Text="build 000000000000"
                                   FontSize="11"
                                   Foreground="#94A3B8"
                                   HorizontalAlignment="Right" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>










