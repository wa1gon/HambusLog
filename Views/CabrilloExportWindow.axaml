<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="HamBusLog.Views.CabrilloExportWindow"
        Title="Cabrillo Export"
        Background="{DynamicResource AppWindowBackgroundBrush}"
        Foreground="{DynamicResource AppForegroundBrush}"
        Width="760"
        Height="520"
        MinWidth="680"
        MinHeight="480"
        WindowStartupLocation="CenterOwner">
    <Window.Styles>
        <Style Selector="TextBlock.FieldLabel">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource AppMutedForegroundBrush}" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style Selector="TextBlock.SectionHeading">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*,Auto" Margin="16">
        <StackPanel Grid.Row="0" Spacing="8">
            <TextBlock Text="Select contest to export"
                       FontSize="14"
                       FontWeight="Bold" />
            <ComboBox ItemsSource="{Binding Contests}"
                      SelectedItem="{Binding SelectedContest}"
                      MinWidth="240">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Display}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="12">
                <Border Padding="12"
                        CornerRadius="8"
                        Background="{DynamicResource AppPanelBackgroundBrush}"
                        BorderBrush="{DynamicResource AppBorderBrush}"
                        BorderThickness="1">
                    <StackPanel Spacing="10">
                        <TextBlock Classes="SectionHeading"
                                   Text="CABRILLO HEADER" />

                        <ItemsControl ItemsSource="{Binding HeaderFields}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="220,*" RowDefinitions="Auto" RowSpacing="6">
                                        <TextBlock Classes="FieldLabel" Text="{Binding DisplayLabel}" />
                                        <StackPanel Grid.Column="1" Spacing="6">
                                            <TextBox Text="{Binding Value}"
                                                     AcceptsReturn="{Binding IsMultiline}"
                                                     TextWrapping="Wrap"
                                                     MinHeight="{Binding InputMinHeight}"
                                                     VerticalAlignment="Top"
                                                     IsVisible="{Binding IsTextInput}" />
                                            <StackPanel Orientation="Horizontal" Spacing="8"
                                                        IsVisible="{Binding IsDateTime}">
                                                <DatePicker SelectedDate="{Binding SelectedDateOffset}" />
                                                <TimePicker SelectedTime="{Binding SelectedTime}"
                                                            ClockIdentifier="24HourClock" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <TextBlock Text="Only contests with exporters can be exported right now."
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource AppMutedForegroundBrush}" />
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Content="Export"
                    IsEnabled="{Binding CanExport}"
                    Click="OnExportClicked"
                    Padding="18,8" />
            <Button Content="Close"
                    Click="OnCloseClicked"
                    Padding="18,8" />
        </StackPanel>
    </Grid>
</Window>






