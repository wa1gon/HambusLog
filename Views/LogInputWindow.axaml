<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:HamBusLog.Views"
        x:Class="HamBusLog.Views.LogInputWindow"
        Title="New Contact"
        RequestedThemeVariant="Dark"
        Background="{DynamicResource AppWindowBackgroundBrush}"
        Foreground="{DynamicResource AppForegroundBrush}"
        Width="860"
        Height="720"
        MinWidth="680"
        MinHeight="560"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <views:ContestTypeConverter x:Key="ContestTypeConverter" />
    </Window.Resources>
    <Window.Styles>
        <Style Selector="TextBlock.FieldLabel">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource AppMutedForegroundBrush}" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style Selector="TextBlock.SectionHeading">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*,Auto" Margin="16,12,16,12">

        <!-- ── Top Bar: Active Radio + Active Log Type ─────────────────── -->
        <Border Grid.Row="0"
                Padding="12,10" Margin="0,0,0,10"
                CornerRadius="8"
                Background="{DynamicResource AppPanelBackgroundBrush}"
                BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="1">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="16">

                <!-- Active Radio label + radio buttons -->
                <TextBlock Grid.Column="0"
                           Text="ACTIVE RADIO"
                           Classes="SectionHeading"
                           VerticalAlignment="Center"
                           Margin="0" />
                <ListBox Grid.Column="1"
                         ItemsSource="{Binding AvailableConnectedRadios}"
                         SelectedItem="{Binding SelectedConnectedRadio, Mode=TwoWay}"
                         Background="Transparent"
                         Foreground="{DynamicResource AppForegroundBrush}"
                         MinHeight="28"
                         MaxHeight="60"
                         BorderThickness="0"
                         Padding="0">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <RadioButton Content="{Binding Display}"
                                         GroupName="ConnectedRadios"
                                         Margin="0,0,16,0"
                                         FontSize="13"
                                         IsChecked="{Binding $parent[ListBoxItem].IsSelected, Mode=TwoWay}" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Divider -->
                <Border Grid.Column="2" Width="1"
                        Background="{DynamicResource AppBorderBrush}"
                        VerticalAlignment="Stretch" Margin="0,2" />

                <TextBlock Grid.Column="3"
                           Text="{Binding CurrentContestDisplayName, StringFormat=LOG TYPE: {0}}"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource AppMutedForegroundBrush}" />

                <CheckBox Grid.Column="4"
                          Content="Stay on top"
                          Margin="10,0,0,0"
                          VerticalAlignment="Center"
                          Foreground="{DynamicResource AppMutedForegroundBrush}"
                          Checked="OnStayOnTopChecked"
                          Unchecked="OnStayOnTopUnchecked"
                          Name="StayOnTopCheckBox" />
            </Grid>
        </Border>


        <!-- ── Contact entry cards ────────────────────────────────────────── -->
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="10">
                <Border Padding="12"
                        CornerRadius="8"
                        Background="{DynamicResource AppPanelBackgroundBrush}"
                        BorderBrush="{DynamicResource AppBorderBrush}"
                        BorderThickness="1">
                    <Grid ColumnDefinitions="Auto,220,16,Auto,170"
                          RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
                          RowSpacing="10">
                        <TextBlock Grid.Row="0" Grid.ColumnSpan="5"
                                   Classes="SectionHeading"
                                   Text="REQUIRED FIELDS" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Classes="FieldLabel" Text="Call" VerticalAlignment="Center" />
                        <Grid Grid.Row="1" Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="6">
                            <TextBox Grid.Column="0"
                                     Text="{Binding InputCall}"
                                     Watermark="K1ABC"
                                     TextChanged="OnInputCallChanged"
                                     LostFocus="OnInputCallLostFocus" />
                            <Button Grid.Column="1"
                                    Content="Lookup"
                                    Padding="10,6"
                                    MinWidth="70"
                                    Click="OnLookupClicked" />
                        </Grid>

                        <TextBlock Grid.Row="1" Grid.Column="3" Classes="FieldLabel" Text="Date (YYYYMMDD)" VerticalAlignment="Center" />
                        <TextBox Grid.Row="1" Grid.Column="4" Text="{Binding InputDate}" Watermark="20260504" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Classes="FieldLabel" Text="Time On (HHMM)" VerticalAlignment="Center" />
                        <Grid Grid.Row="2" Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="6">
                            <TextBox Grid.Column="0" Text="{Binding InputTimeOn}" Watermark="1930" />
                            <Button Grid.Column="1" Content="Now" Click="OnStampNowClicked" Padding="10,6" />
                        </Grid>

                        <TextBlock Grid.Row="2" Grid.Column="3" Classes="FieldLabel" Text="Frequency (MHz)" VerticalAlignment="Center" />
                        <TextBox Grid.Row="2" Grid.Column="4" Text="{Binding InputFreq}" Watermark="14.250" />

                        <TextBlock Grid.Row="3" Grid.Column="0" Classes="FieldLabel" Text="Band" VerticalAlignment="Center" />
                        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding InputBand}" Watermark="20M" />

                        <TextBlock Grid.Row="3" Grid.Column="3" Classes="FieldLabel" Text="Mode" VerticalAlignment="Center" />
                        <ComboBox Grid.Row="3" Grid.Column="4"
                                  ItemsSource="{Binding AvailableModes}"
                                  SelectedItem="{Binding InputMode}"
                                  IsTextSearchEnabled="True"
                                  VerticalAlignment="Center" />

                        <TextBlock Grid.Row="4" Grid.Column="0" Classes="FieldLabel" Text="Station Call" VerticalAlignment="Center" />
                        <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding StationCallSign}" IsReadOnly="True" />

                        <TextBlock Grid.Row="4" Grid.Column="3" Classes="FieldLabel" Text="Operator" VerticalAlignment="Center" />
                        <TextBox Grid.Row="4" Grid.Column="4" Text="{Binding InputOperator}" Watermark="Defaults to station call" TextChanged="OnUppercaseInputChanged" />

                        <TextBlock Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="5"
                                   Text="These are always required for every log entry."
                                   Foreground="{DynamicResource AppMutedForegroundBrush}"
                                   FontSize="11" />
                    </Grid>
                </Border>

                <Border Padding="12"
                        CornerRadius="8"
                        Background="{DynamicResource AppPanelBackgroundBrush}"
                        BorderBrush="{DynamicResource AppBorderBrush}"
                        BorderThickness="1">
                    <Grid ColumnDefinitions="Auto,170,16,Auto,170"
                          RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                          RowSpacing="10">
                        <TextBlock Grid.Row="0" Grid.ColumnSpan="5"
                                   Classes="SectionHeading"
                                   Text="CONTEST REQUIREMENTS" />

                        <TextBlock Grid.Row="1" Grid.ColumnSpan="5"
                                   Text="{Binding CurrentContestDisplayName, StringFormat=Selected: {0}}"
                                   Foreground="{DynamicResource AppMutedForegroundBrush}"
                                   FontSize="11" />
                        <TextBlock Grid.Row="1" Grid.Column="4"
                                   HorizontalAlignment="Right"
                                   Text="{Binding CurrentContestAdifId, StringFormat=ADIF: {0}}"
                                   Foreground="{DynamicResource AppMutedForegroundBrush}"
                                   FontSize="11" />

                        <TextBlock Grid.Row="2" Grid.ColumnSpan="5"
                                   IsVisible="{Binding ShowLegacyNormalExchangeFields}"
                                   Text="Normal Contest Required Exchange"
                                   Foreground="{DynamicResource AppMutedForegroundBrush}"
                                   FontSize="11" />

                        <TextBlock Grid.Row="2" Grid.ColumnSpan="5"
                                   IsVisible="{Binding ShowExchangeHelp}"
                                   Text="{Binding ExchangeHelpText}"
                                   Foreground="{DynamicResource AppMutedForegroundBrush}"
                                   FontSize="11" />

                        <TextBlock Grid.Row="3" Grid.Column="0" IsVisible="{Binding ShowRstSent}" Classes="FieldLabel" Text="RST Sent" VerticalAlignment="Center" />
                        <TextBox Grid.Row="3" Grid.Column="1" IsVisible="{Binding ShowRstSent}" Text="{Binding InputSent}" Watermark="59" />

                        <TextBlock Grid.Row="3" Grid.Column="3" IsVisible="{Binding ShowRstRecv}" Classes="FieldLabel" Text="RST Rec" VerticalAlignment="Center" />
                        <TextBox Grid.Row="3" Grid.Column="4" IsVisible="{Binding ShowRstRecv}" Text="{Binding InputRec}" Watermark="59" />

                        <TextBlock Grid.Row="4" Grid.Column="0" IsVisible="{Binding ShowCountry}" Classes="FieldLabel" Text="Country" VerticalAlignment="Center" />
                        <TextBox Grid.Row="4" Grid.Column="1" IsVisible="{Binding ShowCountry}" Text="{Binding InputCountry}" Watermark="USA" TextChanged="OnUppercaseInputChanged" />

                        <TextBlock Grid.Row="4" Grid.Column="3" IsVisible="{Binding ShowName}" Classes="FieldLabel" Text="Name" VerticalAlignment="Center" />
                        <TextBox Grid.Row="4" Grid.Column="4" IsVisible="{Binding ShowName}" Text="{Binding InputName}" Watermark="Darryl" />

                        <TextBlock Grid.Row="5" Grid.Column="0" IsVisible="{Binding ShowState}" Classes="FieldLabel" Text="State/Prov" VerticalAlignment="Center" />
                        <TextBox Grid.Row="5" Grid.Column="1" IsVisible="{Binding ShowState}" Text="{Binding InputState}" Watermark="MA" TextChanged="OnUppercaseInputChanged" />

                        <TextBlock Grid.Row="5" Grid.Column="0" IsVisible="{Binding ShowExchange}" Classes="FieldLabel" Text="{Binding ExchangeLabel}" VerticalAlignment="Center" />
                        <TextBox Grid.Row="5" Grid.Column="1" IsVisible="{Binding ShowExchange}" Text="{Binding InputExchange}" Watermark="{Binding ExchangeWatermark}" TextChanged="OnUppercaseInputChanged" />

                        <TextBlock Grid.Row="5" Grid.Column="3" IsVisible="{Binding ShowCounty}" Classes="FieldLabel" Text="County" VerticalAlignment="Center" />
                        <TextBox Grid.Row="5" Grid.Column="4" IsVisible="{Binding ShowCounty}" Text="{Binding InputCounty}" Watermark="PUL" TextChanged="OnUppercaseInputChanged" />

                        <TextBlock Grid.Row="6" Grid.Column="0" IsVisible="{Binding ShowGrid}" Classes="FieldLabel" Text="Grid" VerticalAlignment="Center" />
                        <TextBox Grid.Row="6" Grid.Column="1"
                                 Name="GridTextBox"
                                 IsVisible="{Binding ShowGrid}"
                                 Text="{Binding InputGrid}"
                                 Watermark="FN42"
                                 KeyDown="OnGridFieldKeyDown"
                                 TextChanged="OnUppercaseInputChanged" />

                        <TextBlock Grid.Row="2" Grid.ColumnSpan="5"
                                   IsVisible="{Binding IsFieldDay}"
                                   Text="Required Exchange"
                                   Foreground="{DynamicResource AppMutedForegroundBrush}"
                                   FontSize="11" />

                        <TextBlock Grid.Row="3" Grid.Column="0" IsVisible="{Binding ShowFieldDayClass}" Classes="FieldLabel" Text="Class" VerticalAlignment="Center" />
                        <TextBox Grid.Row="3" Grid.Column="1"
                                 Name="FieldDayClassTextBox"
                                 IsVisible="{Binding ShowFieldDayClass}"
                                 Text="{Binding InputFieldDayClass}"
                                 Watermark="1D"
                                 KeyDown="OnFieldDayClassKeyDown"
                                 TextChanged="OnUppercaseInputChanged" />

                        <TextBlock Grid.Row="3" Grid.Column="3" IsVisible="{Binding ShowFieldDaySection}" Classes="FieldLabel" Text="Section" VerticalAlignment="Center" />
                        <TextBox Grid.Row="3" Grid.Column="4"
                                 Name="FieldDaySectionTextBox"
                                 IsVisible="{Binding ShowFieldDaySection}"
                                 Text="{Binding InputFieldDaySection}"
                                 Watermark="EMA"
                                 KeyDown="OnFieldDaySectionKeyDown"
                                 TextChanged="OnUppercaseInputChanged" />

                        <TextBlock Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="5"
                                   IsVisible="{Binding HasContestError}"
                                   Text="{Binding ContestError}"
                                   Foreground="{DynamicResource AppErrorBrush}"
                                   FontSize="11" />

                        <TextBlock Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="5"
                                   IsVisible="{Binding !HasContestError}"
                                   Text="Card #2 changes based on selected Log Type."
                                   Foreground="{DynamicResource AppMutedForegroundBrush}"
                                   FontSize="11" />
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ── Action bar ────────────────────────────────────────────────── -->
        <Border Grid.Row="2" Padding="0,10,0,0"
                BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto" ColumnSpacing="12">
                <Button Grid.Column="0"
                        Name="LogQsoButton"
                        Content="Log QSO"
                        Click="OnLogQsoClicked"
                        Background="{DynamicResource AppButtonNormalBrush}"
                        Foreground="{DynamicResource AppButtonNormalForegroundBrush}"
                        Padding="20,9" CornerRadius="6"
                        FontWeight="Bold" FontSize="13" />
                <Button Grid.Column="1"
                        Content="Clear"
                        Click="OnClearClicked"
                        Background="{DynamicResource AppWarningBrush}"
                        Foreground="{DynamicResource AppHeaderBackgroundBrush}"
                        BorderBrush="{DynamicResource AppWarningBrush}"
                        BorderThickness="1"
                        Padding="16,9" CornerRadius="6" />
                <Grid Grid.Column="2" RowDefinitions="Auto,Auto" RowSpacing="6" VerticalAlignment="Center">
                    <TextBlock Grid.Row="0" Name="StatusLabel"
                               Foreground="{DynamicResource AppErrorBrush}"
                               FontSize="12"
                               HorizontalAlignment="Center" />
                    <Border Grid.Row="1"
                            Padding="10,8"
                            CornerRadius="8"
                            Background="{DynamicResource AppPanelBackgroundBrush}"
                            BorderBrush="{DynamicResource AppBorderBrush}"
                            BorderThickness="1"
                            HorizontalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="Spot remark"
                                       Foreground="{DynamicResource AppMutedForegroundBrush}"
                                       FontSize="11"
                                       VerticalAlignment="Center" />
                            <TextBox Text="{Binding SpotRemark}"
                                     Watermark="Sent with DX spot only"
                                     Width="240"
                                     Padding="8,6"
                                     VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Grid>
                <Button Grid.Column="3"
                        Content="Spot"
                        Click="OnSpotClicked"
                        Background="{DynamicResource AppButtonCautionBrush}"
                        Foreground="{DynamicResource AppButtonCautionForegroundBrush}"
                        Padding="16,9" CornerRadius="6" />
                <Button Grid.Column="4"
                        Content="Self-Spot"
                        Click="OnSelfSpotClicked"
                        Background="{DynamicResource AppButtonCautionBrush}"
                        Foreground="{DynamicResource AppButtonCautionForegroundBrush}"
                        Padding="16,9" CornerRadius="6" />
                <Button Grid.Column="5"
                        Content="Cancel"
                        Click="OnCancelClicked"
                        Background="Transparent"
                        Foreground="{DynamicResource AppMutedForegroundBrush}"
                        BorderBrush="{DynamicResource AppBorderBrush}"
                        BorderThickness="1"
                        Padding="16,9" CornerRadius="6" />
            </Grid>
        </Border>

    </Grid>
</Window>
