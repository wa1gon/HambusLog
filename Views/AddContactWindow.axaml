<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:HamBusLog.Views"
        x:Class="HamBusLog.Views.AddContactWindow"
        Title="Add Contact"
        RequestedThemeVariant="Dark"
        Background="{DynamicResource AppWindowBackgroundBrush}"
        Foreground="{DynamicResource AppForegroundBrush}"
        Width="560"
        Height="640"
        MinWidth="480"
        MinHeight="520"
        WindowStartupLocation="CenterOwner">
    <DockPanel>
        <Border DockPanel.Dock="Top"
                Padding="10,8"
                Background="{DynamicResource AppPanelBackgroundBrush}"
                BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Spacing="10">
                <Button Content="Lookup"
                        Padding="10,6"
                        Background="{DynamicResource AppButtonNormalBrush}"
                        Foreground="{DynamicResource AppButtonNormalForegroundBrush}"
                        Click="OnLookupClicked" />
                <CheckBox Content="Stay on top"
                          Foreground="{DynamicResource AppMutedForegroundBrush}"
                          Checked="OnStayOnTopChecked"
                          Unchecked="OnStayOnTopUnchecked" />
            </StackPanel>
        </Border>
        <views:AddContactView DataContext="{Binding}" />
    </DockPanel>
</Window>
